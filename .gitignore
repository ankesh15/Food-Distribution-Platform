# ==============================================================================
# Food Distribution Platform - Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets, Environment Files & Local Configuration
# ------------------------------------------------------------------------------
# Environment variable files containing sensitive credentials
.env
.env.*
!.env.example
client/.env.local
client/.env.*.local
!client/.env.example

# Private keys, certificates, and credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Cloud provider and local CLI credentials / state
.aws/
.azure/
.gcp/

# ------------------------------------------------------------------------------
# Dependencies & Package Manager Artifacts
# ------------------------------------------------------------------------------
node_modules/
client/node_modules/
jspm_packages/

# Package manager caches, locks, and integrity files
.npm/
.yarn-integrity
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# Build Outputs & Bundles
# ------------------------------------------------------------------------------
/build/
/dist/
/client/build/
/client/dist/
.cache/
.parcel-cache/
*.tgz

# ------------------------------------------------------------------------------
# Runtime, Logs & Process Data
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Process IDs and runtime state
pids/
*.pid
*.seed
*.pid.lock

# Crash dumps, heap snapshots & profiling data
core
core.*
*.cpuprofile
*.heapsnapshot
.v8flags*

# ------------------------------------------------------------------------------
# Uploads & Local Application Data
# ------------------------------------------------------------------------------
# User-uploaded donation images (preserve placeholder .gitkeep)
server/uploads/*
!server/uploads/.gitkeep

# Local database dumps and temporary storage
*.sqlite
*.sqlite3
*.db
dump.rdb
.dynamodb/
mongo-dump/

# Local temporary storage, test binaries, and scratch files
tmp/
.tmp/
scratch/

# ------------------------------------------------------------------------------
# Test & Code Quality Artifacts
# ------------------------------------------------------------------------------
coverage/
client/coverage/
*.lcov
.nyc_output/
.eslintcache
.node_repl_history

# Temporary and scratch files
*.tmp
*.temp

# ------------------------------------------------------------------------------
# Operating System & File System Metadata
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux editor backup files
*~

# ------------------------------------------------------------------------------
# Editor, IDE & Local Agent Configurations
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.swn
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln
.project
.classpath
.settings/
.agents/
.codex/

# ------------------------------------------------------------------------------
# Docker & Deployment Local Overrides
# ------------------------------------------------------------------------------
docker-compose.override.yml
*.local.yml

# ------------------------------------------------------------------------------
# Local Project Documentation & Operator Guides
# ------------------------------------------------------------------------------
FOOD_DISTRIBUTION_PLATFORM_GUIDE.md
AUDIT_REPORT.md
FINAL_FIX_REPORT.md
PRODUCTION_READINESS_REPORT.md